# ── BriefToDeal — Variabili d'ambiente ────────────────────────────────────────
#
# 1. Copia questo file in .env  (mai committare .env su git)
# 2. Compila i valori
# 3. Railway legge le env vars dal dashboard (Settings > Variables)

# Chiave API Anthropic — obbligatoria
# Ottienila su: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Origine CORS consentita — dominio Vercel del frontend
# Esempio: https://brieftodeal.vercel.app
# In sviluppo locale puoi lasciare * oppure http://localhost:5000
ALLOWED_ORIGIN=https://your-project.vercel.app

# Porta del server (Railway la imposta automaticamente — non modificare)
PORT=5000
